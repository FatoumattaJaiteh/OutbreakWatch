# OutbreakWatch Environment Configuration

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin / Auth Security
ADMIN_API_KEY=your-admin-secret-key-here
JWT_SECRET=your-jwt-secret-here

